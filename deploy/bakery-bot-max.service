# systemd unit для MAX-бота на Timeweb Cloud VPS
# Установка:
#   sudo cp bakery-bot-max.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable bakery-bot-max
#   sudo systemctl start bakery-bot-max

[Unit]
Description=Bakery/Coffee Shop MAX Bot
After=network.target

[Service]
Type=simple
User=deploy
WorkingDirectory=/home/deploy/bakery-bot
Environment="PATH=/home/deploy/bakery-bot/venv/bin"
EnvironmentFile=/home/deploy/bakery-bot/.env
Environment="RUN_API=false"
ExecStart=/home/deploy/bakery-bot/venv/bin/python main_max.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
